# OpenWrt release that Gotthard takes its BPI-R4 kernel from.
# Sourced by kernel/build-openwrt.sh and image/build.sh. Keep in sync with
# https://downloads.openwrt.org/releases/ when bumping.

OPENWRT_VERSION=25.12.6
OPENWRT_COMMIT=64900e756efa667774214f9c6b17c113222e01f7   # tag v25.12.6 (peeled)
OPENWRT_REPO=https://github.com/openwrt/openwrt.git

OPENWRT_TARGET=mediatek
OPENWRT_SUBTARGET=filogic
OPENWRT_DEVICE=bananapi_bpi-r4
OPENWRT_PKGARCH=aarch64_cortex-a53

# Kernel shipped by that release (target/linux/generic/kernel-6.12).
KERNEL_VERSION=6.12.112

# Official release artifacts, used by the "official" kernel source in image/build.sh.
OPENWRT_DOWNLOAD=https://downloads.openwrt.org/releases/25.12.6/targets/mediatek/filogic
OPENWRT_SYSUPGRADE=openwrt-25.12.6-mediatek-filogic-bananapi_bpi-r4-squashfs-sysupgrade.itb
OPENWRT_SYSUPGRADE_SHA256=a29542944de5479e545646ff2f5bbc9e8c8c8984818950fe563084ce0499cf57
OPENWRT_KMODS_DIR=kmods/6.12.112-1-f0a7348f9cb959e1bf4d0447669b031e
